% ---------------------------------------------------------------------
% LA RÉFÉRENCE LA PLUS IMPORTANTE DU PAPIER.
% Compare arrivées non contrôlées (Poisson), équidistantes et pilotées
% par le stock. Constate que sous Poisson l'étendue du stock est
% théoriquement non bornée (88 300 t contre 10 800 en équidistant et
% 6 700 en piloté par le stock), et conclut que Poisson est une
% hypothèse inadéquate dès qu'un contrôle existe.
% Le papier doit se positionner par rapport à elle, pas seulement la citer.
% ---------------------------------------------------------------------
@inproceedings{vanasperen2003,
  author    = {van Asperen, Eelco and Dekker, Rommert and Polman, Mark
               and de Swaan Arons, Henk},
  title     = {Modeling Ship Arrivals in Ports},
  booktitle = {Proceedings of the 2003 Winter Simulation Conference},
  editor    = {Chick, Stephen and S{\'a}nchez, Paul J. and Ferrin, David
               and Morrice, Douglas J.},
  pages     = {1737--1744},
  year      = {2003}
}

% Le choix de la loi d'arrivée change la surestarie prédite dans un
% rapport de 1 à 5,7 (Pearson 6 en base ; exponentielle +10 %,
% Erlang +46 %, Weibull +566 %). Preuve que la loi d'arrivée est traitée
% comme une entrée à ajuster, et qu'elle pèse lourd.
